@{
    ViewData["Title"] = "Kitti";
}

<link rel="stylesheet" href="~/css/styles.css" />

<header>
    <h1>Kitti</h1>
</header>

<p>
    <a asp-action="Create" class="btn btn-primary">Add new kitty</a>
</p>

<div class="container">
    <div class="cat-list">
        @foreach (var item in Model)
        {
            <div class="cat-card" style=" width: 250px; height: 400px;">
               
                <a asp-action="Details" asp-route-id="@item.Id">
                    <img src="@item.ImageURL" alt="@item.Name">
                    @* <img src="@Html.DisplayFor(modelItem => item.ImageUrl)" alt="Image" style=" max-width: 250px; max-height: 300px;" /> *@

                </a>
                <h3>@item.Name</h3>
                <p>Breed: @item.Breed</p>
                <p>Age: @item.Age years old</p>
                <div class="btn-group">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                </div>
            </div>
        }
    </div>
</div>
