
 <link rel="stylesheet" href="~/css/search.css" />

<div class="search-hero">
    <h1>🔍 Find Your New Best Friend!</h1>
</div>

<div class="search-form-container">
    <form asp-controller="Pets" asp-action="ShowSearchResults" method="get">
        <div class="form-group">
            <label for="SearchName">Pet Name 🐶🐱</label>
            <input type="text" name="SearchName" class="form-control" placeholder="e.g., Luna, Max, Bella">
        </div>

        <div class="form-group">
            <label for="SearchBreed">Breed 🧬</label>
            <input type="text" name="SearchBreed" class="form-control" placeholder="e.g., Maine Coon, Golden Retriever">
        </div>

        <div class="form-group">
            <label for="SearchType">Type 🐾</label>
            <select name="SearchType" class="form-control">
                <option value="">-- Select --</option>
                <option value="Cat">Cat 😺</option>
                <option value="Dog">Dog 🐶</option>
               @*  <option value="Other">Other 🐰</option> *@
            </select>
        </div>

        <button type="submit" class="btn btn-search">🔍 Search</button>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">⬅ Back to List</a>
        </div>

    </form>
</div>