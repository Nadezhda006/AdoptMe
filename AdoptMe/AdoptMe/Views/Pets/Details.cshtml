@model AdoptMe.Data.Entities.Pet

<link rel="stylesheet" href="~/css/details.css" />

<div class="details-container" style="flex-direction: row;">
    
    <div class="details-image">
        <img src="@Model.ImageURL" alt="@Model.Name">
    </div>

    
    <div class="details-info">
        <h1>🐱 Meet <span style="color: #ff6f61;">@Model.Name</span>!</h1>
        <p><strong>🐾 Breed:</strong> @Model.Breed</p>
        <p><strong>🎂 Age:</strong> @Model.Age years</p>
        <p><strong>🎨 Color:</strong> @Model.Color</p>
        <p><strong>⚖️ Weight:</strong> @Model.Weight kg</p>
        <p><strong>🐾 Type:</strong> @Model.Type</p>
        <p><strong>♥️ Sex:</strong> @Model.Sex</p>
        <p><strong>🏡 Location:</strong> @Model.Location</p>
        <p><strong>💲 Price:</strong> @Model.Price bgn</p>
        <p><strong>😸 Details:</strong> @Model.Details</p>

       
        <div class="details-buttons">
            <a asp-action="Adopt" asp-route-id="@Model.Id" class="btn btn-adopt">❤️ Adopt Me</a>
            <a asp-action="Index" class="btn btn-back">⬅ Back to List</a>
        </div>
    </div>
</div>
